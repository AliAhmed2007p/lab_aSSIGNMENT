# ------------------------------------------------------------------
# COMSATS Connect - single sign-on platform and sample applications
#
# Copy this file to .env and fill in the credentials you want to use.
# Everything works without any credentials; the social sign-in providers
# simply stay disabled until their keys are present here.
# ------------------------------------------------------------------

# Address the browser uses to reach the server. It is used to build the OAuth
# redirect URIs and the issuer claim, so it must match what you open in the
# browser (including the port).
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000

# Allowed browser origins for the chat API. "*" is fine for local development.
CLIENT_ORIGIN=*

# ------------------------------------------------------------------
# Google Sign-In (OAuth 2.0 / OpenID Connect)
# See docs/SSO-SETUP.md for the step-by-step instructions.
# Authorized redirect URI to register:
#   <PUBLIC_BASE_URL>/sso/social/google/callback
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# Facebook Login (Meta OAuth 2.0)
# Valid OAuth Redirect URI to register:
#   <PUBLIC_BASE_URL>/sso/social/facebook/callback
# ------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ------------------------------------------------------------------
# Sample client applications
# These are the client credentials the two bundled applications use. The
# defaults are development values; change them (and re-run "npm run seed" or
# rotate the secret in the admin console) before using this outside a lab.
# ------------------------------------------------------------------
CHAT_CLIENT_ID=comsats-connect-chat
CHAT_CLIENT_SECRET=dev-chat-client-secret

LIBRARY_CLIENT_ID=comsats-library-portal
LIBRARY_CLIENT_SECRET=dev-library-client-secret

LAHORE_CLIENT_ID=comsats-lahore-portal
LAHORE_CLIENT_SECRET=dev-lahore-client-secret

# ------------------------------------------------------------------
# Optional: sign the tokens with your own RSA key instead of the key pair the
# server generates on first start (server/data/keys.json).
# ------------------------------------------------------------------
# SSO_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------
# Chat limits (optional)
# ------------------------------------------------------------------
MESSAGE_MAX_LENGTH=2000
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_MS=10000
HISTORY_LIMIT=50
